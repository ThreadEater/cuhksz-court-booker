{
  "manifest_version": 3,
  "name": "羽约 · 单场定时预约",
  "version": "1.1.0",
  "description": "单账号羽毛球定时预约，支持只填表演练、耗时诊断和订单核验。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://booking.cuhk.edu.cn/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "羽约 · 单场预约",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://booking.cuhk.edu.cn/a/*"
      ],
      "js": [
        "site.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.1.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
